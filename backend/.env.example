# Copia este archivo como .env y completa valores solo para tu entorno local.
# No guardes contraseñas reales en Git.

# Acceso al panel administrativo (SUBLI_ADMIN_PASSWORD: mínimo 16 caracteres)
SUBLI_ADMIN_USERNAME=admin-local
SUBLI_ADMIN_PASSWORD=CambiaEstaClavePorUnaDe16Caracteres

# Variables de entorno reconocidas por Spring Boot para las propiedades:
# spring.datasource.url, spring.datasource.username y spring.datasource.password.
# Mantén los valores sin comillas y sin espacios al inicio o al final.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/subli_inca
SPRING_DATASOURCE_USERNAME=root
# iniciar-backend.ps1 ignora esta variable si application*.properties ya
# define directamente spring.datasource.password.
SPRING_DATASOURCE_PASSWORD=CambiaEstaClavePorTuClaveLocal
# spring.datasource.driver-class-name
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# Opcional: orígenes del frontend separados por coma.
# SUBLI_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
